# 全新 Docker 部署：复制为 .env，填写下面三个必填值，再 docker compose up -d。
# 已有部署继续使用原 .env.lean：docker compose --env-file .env.lean up -d。
LEAN_PROJECT_NAME=atm-erp-lean
# 正式包的 compose 已固定多架构镜像摘要，留空沿用；源码开发需指定本地镜像。
LEAN_IMAGE=
LEAN_HTTP_PORT=8080
LEAN_BIND_ADDRESS=127.0.0.1
LEAN_ALLOWED_HOSTS=localhost,127.0.0.1
LEAN_ENVIRONMENT=production
# 使用各不相同的随机值。SECRET_KEY 至少32字符，初始管理员密码至少12字符。
LEAN_DB_PASSWORD=
LEAN_SECRET_KEY=
LEAN_ADMIN_PASSWORD=
# 默认容器内 OTA 自动认证，无需填写令牌。仅旧宿主机模式使用以下令牌。
LEAN_OTA_AGENT_TOKEN=
LEAN_OTA_MODE=container
