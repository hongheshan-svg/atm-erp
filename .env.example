# ERP系统环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改配置

# Django配置
# 生成强随机值:python -c "import secrets;print(secrets.token_urlsafe(64))"
# 留着 django-insecure- 开头的占位值会触发 `check --deploy` 的 W009。
SECRET_KEY=django-insecure-PLEASE-CHANGE-THIS-TO-RANDOM-STRING
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# 数据库配置
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=PLEASE-CHANGE-THIS-STRONG-PASSWORD
DB_HOST=postgres
DB_PORT=5432

# Redis配置
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/1

# Celery配置
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS配置
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# 前端URL
FRONTEND_URL=http://localhost/erp/

# JWT配置
JWT_ACCESS_LIFETIME_MINUTES=120
JWT_REFRESH_LIFETIME_DAYS=7

# HTTPS配置（生产环境启用）
# 总开关:站点确实跑在 HTTPS（可信证书）之后时设 True,下面四项一并生效,
# 不必逐个记住变量名。纯 HTTP 部署下打开会被 301 到 https 而无法访问,
# 且 HSTS 会被浏览器缓存一年——先备好证书再开。
DEPLOY_HTTPS=False
# 以下每项可单独覆盖总开关。必须保持注释状态才算「跟随 DEPLOY_HTTPS」——
# 写成空值不等于未设置(空值会被读成 False,SECURE_HSTS_SECONDS 空值还会直接报错)。
#SECURE_SSL_REDIRECT=True
#SECURE_HSTS_SECONDS=31536000
#SESSION_COOKIE_SECURE=True
#CSRF_COOKIE_SECURE=True
# preload 需主动提交到浏览器内置列表且极难撤回,不随总开关联动。
SECURE_HSTS_PRELOAD=False

# ===========================================
# Docker 镜像（一键安装）
# ===========================================
# 镜像仓库与所有者（默认 GHCR 官方包）
REGISTRY=ghcr.io
IMAGE_OWNER=hongheshan-svg
# 镜像版本标签（如 0.2.0；latest 为最新）
IMAGE_TAG=latest

# 宿主机端口（如 80/443 被占用可改）
HTTP_PORT=80
HTTPS_PORT=443

# ===========================================
# 初始管理员（首次启动自动创建）
# ===========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 是否灌入示例数据：0=否 1=是
SEED_DEMO_DATA=0
# 可选：示例用户统一密码；留空时每次 seed 自动生成
DEMO_USER_PASSWORD=
