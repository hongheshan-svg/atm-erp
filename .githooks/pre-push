#!/usr/bin/env bash
# ATM-ERP 推送前门禁(随仓库版本化,通过 git config core.hooksPath .githooks 启用)
#
# 跑与本次改动相关的 CI 后端测试分组。存在的理由和 pre-commit 一样:
# 最近 40 次 CI run 里有 4 次挂在真实测试失败(分组①②④ 与 integration 都挂过),
# 而本地没有任何等价的执行路径,只能推上去才发现。
#
# 分组按改动自动挑选: 改单个业务 app 约 30 秒,改 apps/core 或 config 则全量约 6 分半。
# 与后端无关的改动(docs/、nginx/ 等)秒级放行,完全不启动 Docker。
#
# 绕过: git push --no-verify
# 预热(首次建库约 7 分钟,建议先手动跑一次): bash scripts/precheck-tests.sh --up
set -euo pipefail

c_info(){ printf '\033[0;36m[i]\033[0m %s\n' "$1"; }
c_warn(){ printf '\033[0;33m[!]\033[0m %s\n' "$1" >&2; }
c_err(){  printf '\033[0;31m[\xe2\x9c\x97]\033[0m %s\n' "$1" >&2; }

REPO_ROOT="$(git rev-parse --show-toplevel)"
ZERO='^0*$'

changed="$(mktemp)"
trap 'rm -f "$changed"' EXIT

# git 通过 stdin 传入每个待推送 ref: <local_ref> <local_sha> <remote_ref> <remote_sha>
# 注意: 这里不能写 `IFS= read`——IFS 置空会关掉字段分隔,导致一整行都被塞进 _local_ref、
# 其余三个变量全部为空(已手工复现)。这条 stdin 需要按空白切成 4 个字段,必须用默认 IFS。
#
# `|| [[ -n "${_local_ref:-}" ]]`: 与 scripts/precheck-tests.sh 里 classify_changes 的坑
# 同源——read 读到不带末尾换行符的最后一行时,内容进了变量但 read 自身返回非零,裸
# `while read` 会把这次判假当成 EOF、漏掉最后一条待推送 ref。这个坑本项目已经踩过一次
# 并修过(见 5f61959),这里同样处理。`${_local_ref:-}` 是为了在 stdin 完全为空(理论上
# 不会发生,但 set -u 下第一次 read 就失败时变量从未被赋值)时不触发 unbound variable。
while read -r _local_ref local_sha _remote_ref remote_sha || [[ -n "${_local_ref:-}" ]]; do
  # local_sha 全 0 = 删除远程分支,没有代码变更可查
  [[ "$local_sha" =~ $ZERO ]] && continue

  if [[ "$remote_sha" =~ $ZERO ]]; then
    # remote_sha 全 0 = 该分支在远端尚不存在(新分支首推),以 main 为基线
    base="$(git rev-parse --verify --quiet origin/main || git rev-parse --verify --quiet main || true)"
  else
    base="$remote_sha"
  fi

  # remote_sha 非空不等于本地对象库里真的有这个 commit——常见于 rebase 后 force-push
  # (远端旧 tip 已经不在本地历史里)或浅克隆。这种情况下 `git diff "$base" ...` 会
  # fatal: bad object、exit 128。以前这里直接 `git diff ... 2>/dev/null || true`,把报错
  # 文本和退出码一起吞掉,这条 ref 对 $changed 零贡献——如果这是本次 push 唯一的 ref,
  # 会让 `[[ ! -s "$changed" ]]` 命中、静默 exit 0 放行,等于没跑测试却报绿,门禁形同虚设
  # (已用 `git diff --name-only ffff...ff HEAD` 手工复现 fatal: bad object)。
  # 这里先校验对象是否存在,不存在就打警告并回落到 origin/main(与新分支首推同一套基线),
  # 而不是静默吞掉。
  if [[ -n "$base" ]] && ! git cat-file -e "$base" 2>/dev/null; then
    c_warn "基线 $base 在本地对象库中不存在(rebase 后 force-push 或浅克隆常见),回落到 origin/main"
    base="$(git rev-parse --verify --quiet origin/main || git rev-parse --verify --quiet main || true)"
  fi

  if [[ -z "$base" ]]; then
    # 回落之后仍然没有可用基线(例如全新仓库,origin/main 也不存在),放行交给 CI——
    # 但必须可见,不能是无声的 exit 0。
    c_warn "无法为 $_local_ref 确定改动基线,本地跳过预检,交由 CI 兜底"
    continue
  fi
  c_info "$_local_ref: 基线 $base"
  # 上面只校验了 $base,没校验 $local_sha——理论上 git 不该让你 push 一个本地对象库里
  # 没有的 commit,但不额外验证它,直接让下面这条 git diff 兜底: base 或 local_sha
  # 任一不可达,git diff 都会 fatal 且非零退出,被 `if !` 捕获后报错并 exit 1,而不是像
  # 原来的 `2>/dev/null || true` 那样把报错文本和退出码一起吞掉、让这条 ref 对 $changed
  # 零贡献(唯一 ref 时会导致 `[[ ! -s "$changed" ]]` 命中、静默 exit 0——门禁形同虚设)。
  if ! git diff --name-only "$base" "$local_sha" >> "$changed"; then
    c_err "无法计算 $_local_ref 的改动(git diff 失败,见上方报错)。修复后重试,或 git push --no-verify 跳过。"
    exit 1
  fi
done

if [[ ! -s "$changed" ]]; then
  exit 0
fi

sort -u "$changed" -o "$changed"

if ! bash "$REPO_ROOT/scripts/precheck-tests.sh" --from-files "$changed"; then
  c_err '推送已中止。确需跳过预检用: git push --no-verify'
  exit 1
fi
